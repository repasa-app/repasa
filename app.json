{
 "nombre": "Repasa",
 "id": "repasa",
 "version": "0.1.0",
 "repo": "repasa-app/repasa",
 "datos": "visible",
 "icono": "docs/favicon.svg",
 "plataformas": [
  "mac",
  "ios",
  "android"
 ],
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "ultimo_perfil": {
   "tipo": "texto",
   "patron": "[a-z0-9-]{1,80}"
  },
  "tema": [
   "sistema",
   "claro",
   "oscuro"
  ]
 },
 "sin_acciones": [
  "listaIA"
 ],
 "empaquetado": {
  "descripcion": "Estudia con fotos de tu cuaderno: resumen, preguntas y tarjetas con la IA de un adulto.",
  "categoria": "public.app-category.education",
  "linux_categoria": "Education",
  "carpetas": [
   "temas",
   "motor"
  ],
  "quitar": [
   "ui/demo",
   "temas/README.md"
  ],
  "permisos": [],
  "ocupada": []
 },
 "acciones": {
  "guardarPerfil": {
   "script": "guardar.py",
   "scriptDeLaApp": true,
   "args": [
    "perfil"
   ],
   "entrada": "archivo",
   "datos": {
    "*": "pasar"
   },
   "responde": null,
   "cola": "escritura",
   "limite": 30
  },
  "guardarProgreso": {
   "script": "guardar.py",
   "scriptDeLaApp": true,
   "args": [
    "progreso"
   ],
   "entrada": "archivo",
   "datos": {
    "perfil": {
     "tipo": "texto",
     "max": 80,
     "requerido": true
    },
    "*": "pasar"
   },
   "responde": null,
   "cola": "escritura",
   "limite": 30
  },
  "guardarPruebas": {
   "script": "guardar.py",
   "scriptDeLaApp": true,
   "args": [
    "pruebas"
   ],
   "entrada": "archivo",
   "datos": {
    "*": "pasar"
   },
   "responde": null,
   "cola": "escritura",
   "limite": 30
  },
  "temaAMano": {
   "script": "crear_tema.py",
   "scriptDeLaApp": true,
   "args": [
    "amano"
   ],
   "entrada": "archivo",
   "datos": {
    "titulo": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    },
    "ramo": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    },
    "curso": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    },
    "resumen": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    },
    "conceptos": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    },
    "preguntas": {
     "tipo": "texto",
     "max": 30000,
     "recortar": true
    }
   },
   "inyectar": {
    "idioma": "idiomaUI"
   },
   "responde": "temaCreado",
   "limite": 60
  },
  "agregarDelCatalogo": {
   "script": "crear_tema.py",
   "scriptDeLaApp": true,
   "args": [
    "catalogo"
   ],
   "entrada": "archivo",
   "datos": {
    "id": {
     "tipo": "texto",
     "max": 60,
     "requerido": true
    }
   },
   "responde": "temaGuardado",
   "cola": "escritura",
   "limite": 60
  },
  "explicar": {
   "script": "explicar.py",
   "scriptDeLaApp": true,
   "args": [],
   "entrada": "archivo",
   "datos": {
    "tema": {
     "tipo": "texto",
     "max": 60,
     "requerido": true
    },
    "pregunta": {
     "tipo": "texto",
     "max": 80,
     "requerido": true
    },
    "respondio": {
     "tipo": "texto",
     "max": 300,
     "recortar": true
    }
   },
   "responde": "explicado",
   "limite": 240
  }
 }
}
